#!/usr/bin/env bash
set -euo pipefail
for _ in $(seq 1 60); do
  if xdpyinfo -display "${DISPLAY:-:1}" >/dev/null 2>&1; then
    break
  fi
  sleep 1
done

profile_dir="${OPERA_PROFILE_DIR:-${HOME}/.config/opera}"
frozen_dir="${OPERA_FROZEN_PROFILE_DIR:-${HOME}/opera-profile-frozen}"
host_profile_dir="${OPERA_HOST_PROFILE_SOURCE_DIR:-/mnt/host-opera-profile}"
log_dir="${PI_COMPUTER_LOG_DIR:-${HOME}/pi-computer-logs}"
xdg_data_home="${XDG_DATA_HOME:-${HOME}/.data}"
cdp_host="${CDP_HOST:-127.0.0.1}"
cdp_port="${CDP_PORT:-9222}"

mkdir -p "$(dirname "${profile_dir}")" "$(dirname "${frozen_dir}")" "${log_dir}" "${xdg_data_home}" "${xdg_data_home}/pki/nssdb"

has_entries() {
  local dir="$1"
  [ -d "${dir}" ] && find "${dir}" -mindepth 1 -print -quit | grep -q .
}

replace_tree() {
  local src="$1"
  local dst="$2"
  local tmp="${dst}.tmp.$$"
  rm -rf "${tmp}"
  mkdir -p "${tmp}"
  if has_entries "${src}"; then
    tar -C "${src}" -cf - . | tar -C "${tmp}" -xf -
  fi
  rm -rf "${dst}"
  mv "${tmp}" "${dst}"
}

if has_entries "${host_profile_dir}"; then
  echo "refreshing frozen Opera profile from host source ${host_profile_dir} -> ${frozen_dir}" >&2
  replace_tree "${host_profile_dir}" "${frozen_dir}"
fi

if has_entries "${frozen_dir}"; then
  echo "restoring live Opera profile from frozen snapshot ${frozen_dir} -> ${profile_dir}" >&2
  replace_tree "${frozen_dir}" "${profile_dir}"
else
  mkdir -p "${profile_dir}"
fi

rm -f "${profile_dir}/SingletonLock" "${profile_dir}/SingletonSocket" "${profile_dir}/SingletonCookie"

exec dbus-run-session -- /usr/bin/opera \
  --no-first-run \
  --disable-default-apps \
  --disable-dev-shm-usage=false \
  --disable-gpu \
  --no-sandbox \
  --remote-debugging-address="${cdp_host}" \
  --remote-debugging-port="${cdp_port}" \
  --remote-allow-origins="http://${cdp_host}:${cdp_port}" \
  --user-data-dir="${profile_dir}" \
  about:blank
