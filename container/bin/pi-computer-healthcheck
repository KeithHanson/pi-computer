#!/usr/bin/env bash
set -euo pipefail
fail() { echo "healthcheck failed: $*" >&2; exit 1; }
xdpyinfo -display "${DISPLAY:-:1}" >/dev/null 2>&1 || fail "X display ${DISPLAY:-:1} not ready"
pgrep -u "$(id -u)" -x fluxbox >/dev/null || fail "fluxbox not running"
pgrep -u "$(id -u)" -x socat >/dev/null || fail "VNC IPv4 loopback relay not running"
pgrep -u "$(id -u)" -f 'websockify|novnc_proxy' >/dev/null || fail "noVNC/websockify backend not running"
pgrep -u "$(id -u)" -f '/opt/pi-computer/novnc-gate/server.js' >/dev/null || fail "noVNC auth gate not running"
pgrep -u "$(id -u)" -f '/usr/lib/x86_64-linux-gnu/opera/opera|/usr/bin/opera' >/dev/null || fail "Opera not running"
novnc_token="${PI_COMPUTER_NOVNC_TOKEN:-${NOVNC_AUTH_TOKEN:-local-novnc-token-change-me}}"
novnc_port="${NOVNC_PORT:-6080}"
novnc_backend_port="${NOVNC_BACKEND_PORT:-6081}"
unauth_code="$(curl -sS -o /tmp/pi-computer-novnc-unauth.health -w '%{http_code}' "http://127.0.0.1:${novnc_port}/vnc.html" || true)"
[ "${unauth_code}" = "401" ] || fail "noVNC auth gate should reject unauthenticated HTTP with 401, got ${unauth_code}"
curl -fsS -H "Authorization: Bearer ${novnc_token}" "http://127.0.0.1:${novnc_port}/vnc.html" >/dev/null || fail "authenticated noVNC HTTP endpoint not responding"
curl -fsS "http://127.0.0.1:${novnc_backend_port}/vnc.html" >/dev/null || fail "noVNC loopback backend not responding"
curl -fsS "http://127.0.0.1:${API_PORT:-8080}/healthz" >/dev/null || fail "Node task API /healthz not responding"
cdp_host="${CDP_HOST:-127.0.0.1}"
cdp_port="${CDP_PORT:-9222}"
version_json="$(curl -fsS "http://${cdp_host}:${cdp_port}/json/version")" || fail "Opera CDP /json/version not responding on ${cdp_host}:${cdp_port}"
echo "${version_json}" | grep -q '"Browser"' || fail "Opera CDP /json/version missing Browser field"
vnc_port="${VNC_PORT:-5900}"
listeners="$( (ss -ltn 2>/dev/null || netstat -ltn 2>/dev/null) || true )"
echo "${listeners}" | grep -Eq "(^|[[:space:]])127\.0\.0\.1:${vnc_port}([[:space:]]|$)" || fail "IPv4 loopback VNC relay not listening"
cdp_host_re="${cdp_host//./\\.}"
echo "${listeners}" | grep -Eq "(^|[[:space:]])${cdp_host_re}:${cdp_port}([[:space:]]|$)" || fail "CDP not listening on ${cdp_host}:${cdp_port}"
if echo "${listeners}" | grep -Eq "(^|[[:space:]])(0\.0\.0\.0|:::|\*):${cdp_port}([[:space:]]|$)"; then
  fail "CDP must not listen on a wildcard address"
fi
if echo "${listeners}" | grep -Eq "(^|[[:space:]]):::${vnc_port}([[:space:]]|$)"; then
  fail "VNC must not listen on IPv6 wildcard :::${vnc_port}"
fi
if nc -z -w 1 ::1 "${vnc_port}" >/dev/null 2>&1; then
  fail "VNC must not accept IPv6 loopback ::1"
fi
echo "healthy: desktop, noVNC, task API, IPv4-only VNC loopback, Opera, and loopback-only CDP are ready"
