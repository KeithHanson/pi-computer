# Copy to .env for local validation. Do not commit real secrets.

# Optional: mount only the host Pi auth.json file read-only so the container
# can copy it into /home/pi/.pi/agent/auth.json during bootstrap.
# Do not point this at the broader ~/.pi/agent directory.
HOST_PI_AUTH_JSON=/home/your-user/.pi/agent/auth.json

# Optional: override the Pi harness provider/model used for bounded browser tasks.
PI_HARNESS_PROVIDER=openai-codex
PI_HARNESS_MODEL=gpt-5.4
PI_BROWSER_TASK_MAX_ARTICLES=5

# Optional host port overrides if 6080/8080 are already in use locally.
# NOVNC_HOST_PORT=6080
# API_HOST_PORT=8080
